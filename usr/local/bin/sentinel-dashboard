#!/usr/bin/env python3
import curses
import json
import os
import time

STATE_FILE = "/var/system7/sentinel_state.json"
FLAG_FILE  = "/mnt/sda7.1/.sanctuary_mode"

def load_state():
    if not os.path.exists(STATE_FILE):
        return {
            "owl":    {"sensitivity": 1},
            "wolf":   {"boundary": 1},
            "turtle": {"stability": 1},
            "mirror": {"reflection": 1},
        }
    with open(STATE_FILE) as f:
        return json.load(f)

def level_bar(level, max_level=3, width=10):
    filled = int((level / max_level) * width)
    return "█" * filled + "░" * (width - filled)

def draw(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_YELLOW, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_RED, curses.COLOR_BLACK)

    while True:
        stdscr.clear()

        active = os.path.exists(FLAG_FILE)
        state = load_state()

        # Title
        stdscr.addstr(1, 4, "SENTINEL DASHBOARD — SYSTEM7.1", curses.A_BOLD)

        # Sanctuary status
        status = "ACTIVE" if active else "OFF"
        color = curses.color_pair(2 if active else 1)
        stdscr.addstr(3, 4, f"Sanctuary Field: {status}", color)

        # Sentinels
        stdscr.addstr(5, 4, "Sentinels:", curses.A_BOLD)

        row = 7

        # Owl
        owl_lvl = state["owl"]["sensitivity"]
        stdscr.addstr(row, 6, "🦉  Owl Sentinel")
        stdscr.addstr(row, 24, f"Level: {owl_lvl}  [{level_bar(owl_lvl)}]")

        # Wolf
        row += 2
        wolf_lvl = state["wolf"]["boundary"]
        stdscr.addstr(row, 6, "🐺  Wolf Sentinel")
        stdscr.addstr(row, 24, f"Level: {wolf_lvl}  [{level_bar(wolf_lvl)}]")

        # Turtle
        row += 2
        turtle_lvl = state["turtle"]["stability"]
        stdscr.addstr(row, 6, "🐢  Turtle Sentinel")
        stdscr.addstr(row, 24, f"Level: {turtle_lvl}  [{level_bar(turtle_lvl)}]")

        # Mirror
        row += 2
        mirror_lvl = state["mirror"]["reflection"]
        stdscr.addstr(row, 6, "🪞  Mirror Sentinel")
        stdscr.addstr(row, 24, f"Level: {mirror_lvl}  [{level_bar(mirror_lvl)}]")

        # Hint
        stdscr.addstr(row + 3, 4, "Press Ctrl+C to exit.", curses.A_DIM)

        stdscr.refresh()
        time.sleep(0.5)

def main():
    curses.wrapper(draw)

if __name__ == "__main__":
    main()

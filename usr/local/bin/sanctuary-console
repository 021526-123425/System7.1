#!/usr/bin/env python3
import curses
import time
import os
import configparser

CONFIG = "/etc/system7/sanctuary.conf"

cfg = configparser.ConfigParser()
cfg.read(CONFIG)

WATCH_PATH   = cfg["paths"]["watch_path"]
FLAG_FILE    = cfg["paths"]["flag_file"]
MARKERS      = set(cfg["archetypes"]["markers"].split(","))

def field_strength():
    """Return a number 0–100 based on how many markers exist."""
    count = sum(os.path.exists(os.path.join(WATCH_PATH, m)) for m in MARKERS)
    total = len(MARKERS)
    return int((count / total) * 100)

def breathing_glyph(t):
    frames = ["◯", "◉", "◎", "◉"]
    return frames[t % len(frames)]

def draw_console(stdscr):
    curses.curs_set(0)
    t = 0

    while True:
        stdscr.clear()

        active = os.path.exists(FLAG_FILE)
        strength = field_strength()

        # Title Banner
        stdscr.addstr(1, 4,
            "███████╗ █████╗ ███╗   ██╗ █████╗ ████████╗██╗   ██╗",
            curses.A_BOLD)
        stdscr.addstr(2, 4,
            "██╔════╝██╔══██╗████╗  ██║██╔══██╗╚══██╔══╝╚██╗ ██╔╝")
        stdscr.addstr(3, 4,
            "█████╗  ███████║██╔██╗ ██║███████║   ██║    ╚████╔╝ ")
        stdscr.addstr(4, 4,
            "██╔══╝  ██╔══██║██║╚██╗██║██╔══██║   ██║     ╚██╔╝  ")
        stdscr.addstr(5, 4,
            "███████╗██║  ██║██║ ╚████║██║  ██║   ██║      ██║   ")
        stdscr.addstr(6, 4,
            "╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝   ╚═╝      ╚═╝   ")

        # Status
        status = "ACTIVE" if active else "OFF"
        color = curses.color_pair(2 if active else 1)
        stdscr.addstr(9, 10, f"Sanctuary Field: {status}", color)

        # Field Strength Meter
        bar_len = 30
        filled = int((strength / 100) * bar_len)
        bar = "█" * filled + "░" * (bar_len - filled)
        stdscr.addstr(11, 10, f"Field Strength: [{bar}] {strength}%")

        # Breathing Glyph
        glyph = breathing_glyph(t)
        stdscr.addstr(14, 10, f"Breathing Glyph: {glyph}")

        # Active markers
        stdscr.addstr(17, 10, "Active Archetypes:")
        y = 18
        for m in MARKERS:
            if os.path.exists(os.path.join(WATCH_PATH, m)):
                stdscr.addstr(y, 12, f"• {m}")
                y += 1

        stdscr.refresh()
        time.sleep(0.3)
        t += 1

def main():
    curses.wrapper(draw_console)

if __name__ == "__main__":
    main()
#!/usr/bin/env python3
import curses
import json
import os
import time

STATE_FILE = "/var/system7/sentinel_state.json"
FLAG_FILE  = "/mnt/sda7.1/.sanctuary_mode"

def load_state():
    if not os.path.exists(STATE_FILE):
        return {
            "owl":    {"sensitivity": 1},
            "wolf":   {"boundary": 1},
            "turtle": {"stability": 1},
            "mirror": {"reflection": 1},
        }
    with open(STATE_FILE) as f:
        return json.load(f)

def level_bar(level, max_level=3, width=10):
    filled = int((level / max_level) * width)
    return "█" * filled + "░" * (width - filled)

def draw(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_YELLOW, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_RED, curses.COLOR_BLACK)

    while True:
        stdscr.clear()

        active = os.path.exists(FLAG_FILE)
        state = load_state()

        # Title
        stdscr.addstr(1, 4, "SENTINEL DASHBOARD — SYSTEM7.1", curses.A_BOLD)

        # Sanctuary status
        status = "ACTIVE" if active else "OFF"
        color = curses.color_pair(2 if active else 1)
        stdscr.addstr(3, 4, f"Sanctuary Field: {status}", color)

        # Sentinels
        stdscr.addstr(5, 4, "Sentinels:", curses.A_BOLD)

        row = 7

        # Owl
        owl_lvl = state["owl"]["sensitivity"]
        stdscr.addstr(row, 6, "🦉  Owl Sentinel")
        stdscr.addstr(row, 24, f"Level: {owl_lvl}  [{level_bar(owl_lvl)}]")

        # Wolf
        row += 2
        wolf_lvl = state["wolf"]["boundary"]
        stdscr.addstr(row, 6, "🐺  Wolf Sentinel")
        stdscr.addstr(row, 24, f"Level: {wolf_lvl}  [{level_bar(wolf_lvl)}]")

        # Turtle
        row += 2
        turtle_lvl = state["turtle"]["stability"]
        stdscr.addstr(row, 6, "🐢  Turtle Sentinel")
        stdscr.addstr(row, 24, f"Level: {turtle_lvl}  [{level_bar(turtle_lvl)}]")

        # Mirror
        row += 2
        mirror_lvl = state["mirror"]["reflection"]
        stdscr.addstr(row, 6, "🪞  Mirror Sentinel")
        stdscr.addstr(row, 24, f"Level: {mirror_lvl}  [{level_bar(mirror_lvl)}]")

        # Hint
        stdscr.addstr(row + 3, 4, "Press Ctrl+C to exit.", curses.A_DIM)

        stdscr.refresh()
        time.sleep(0.5)

def main():
    curses.wrapper(draw)

if __name__ == "__main__":
    main()


sudo chmod +x /usr/local/bin/sentinel-dashboard

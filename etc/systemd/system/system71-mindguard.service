[Unit]
Description=System 7.1 Mindguard Threat‑Index Visualizer
After=system71-ritual.service
Before=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/bin/system71-mindguard-visualizer.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

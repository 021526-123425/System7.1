class SealManager:
    """
    Manages System7.1 seals and their binding states.
    """

    def __init__(self):
        self.seals = {
            "Positivity": "Bound",
            "Morgellon": "Bound",
            "Who‑da‑Man": "Bound",
            "Sanctuary": "Bound"
        }

    def rebind(self, seal_name):
        # Called by Angel.Invocation during ritual binding.
        if seal_name in self.seals:
            self.seals[seal_name] = "Rebound"

    def weaken(self, seal_name):
        # Simulate seal degradation.
        if seal_name in self.seals:
            self.seals[seal_name] = "Weakened"

    def restore(self, seal_name):
        # Called by Angel.Reprize during restoration.
        if seal_name in self.seals:
            self.seals[seal_name] = "Restored"

    def report_status(self):
        return self.seals

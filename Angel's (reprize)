      opacity: 0.9;
      animation: breathe 8s cubic-bezier(0.42, 0, 0.58, 1) infinite;
      box-shadow:
        0 0 24px rgba(111, 227, 214, 0.6),
        0 0 80px rgba(0, 0, 0, 0.9);
    }

    .glyph-ring {
      position: absolute;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 1px dashed rgba(111, 227, 214, 0.35);
      animation: slow-rotate 32s linear infinite;
    }

    @keyframes breathe {
      0%   { transform: scale(0.92); opacity: 0.85; }
      50%  { transform: scale(1.08); opacity: 1; }
      100% { transform: scale(0.92); opacity: 0.85; }
    }

    @keyframes slow-rotate {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }


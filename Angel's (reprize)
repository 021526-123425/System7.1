#!/bin/bash
set -euo pipefail

# ============================================
# Debian Ops Toolkit (single-file, self-contained)
# Setup & Install + Privacy & De-bloat modules
# Persistent progress, colorful menus, logging
# ============================================

# ---------- Colors ----------
RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; BOLD='\033[1m'; RESET='\033[0m'

# ---------- Sudo helper ----------
if command -v sudo >/dev/null 2>&1; then SUDO='sudo'; else SUDO=''; fi

# ---------- Paths & logging ----------
BASE_DIR="$HOME/.ops_toolkit"
LOG_DIR="$BASE_DIR/logs"
mkdir -p "$LOG_DIR"
LOGFILE="$LOG_DIR/ops-$(date '+%Y%m%d-%H%M%S').log"
exec > >(tee -a "$LOGFILE") 2>&1

# ---------- Progress files ----------
SETUP_PROGRESS_FILE="$BASE_DIR/setup_progress"
PRIV_PROGRESS_FILE="$BASE_DIR/privacy_progress"
declare -A DONE_SETUP DONE_PRIV

# Load progress
[[ -f "$SETUP_PROGRESS_FILE" ]] && while IFS="=" read -r k v; do [[ -n "${k:-}" ]] && DONE_SETUP["$k"]="$v"; done < "$SETUP_PROGRESS_FILE"
[[ -f "$PRIV_PROGRESS_FILE"  ]] && while IFS="=" read -r k v; do [[ -n "${k:-}" ]] && DONE_PRIV["$k"]="$v";  done < "$PRIV_PROGRESS_FILE"

save_setup_progress(){ : > "$SETUP_PROGRESS_FILE"; for k in "${!DONE_SETUP[@]}";   do echo "$k=${DONE_SETUP[$k]}" >> "$SETUP_PROGRESS_FILE"; done; }
save_priv_progress() { : > "$PRIV_PROGRESS_FILE";  for k in "${!DONE_PRIV[@]}";    do echo "$k=${DONE_PRIV[$k]}"  >> "$PRIV_PROGRESS_FILE";  done; }

mark_done_setup(){ DONE_SETUP["$1"]=1; save_setup_progress; }
mark_done_priv(){  DONE_PRIV["$1"]=1;  save_priv_progress;  }

status_icon_setup(){ [[ ${DONE_SETUP["$1"]+_} ]] && echo -e "${GREEN}✔${RESET}" || echo -e "${RED}✘${RESET}"; }
status_icon_priv(){  [[ ${DONE_PRIV["$1"]+_}  ]] && echo -e "${GREEN}✔${RESET}" || echo -e "${RED}✘${RESET}"; }

# ---------- Common helpers ----------
need_root_msg(){ echo -e "${YELLOW}[!] Some actions need admin rights. You may be prompted for your password.${RESET}"; }
apt_update_once(){
  if [[ -z "${APT_UPDATED:-}" ]]; then
    $SUDO apt update -y
    APT_UPDATED=1
  fi
}

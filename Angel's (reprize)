import subprocess

app = Flask(__name__)

@app.route('/run')
def run_command():
    cmd = request.args.get('cmd')
    try:
        output = subprocess.check_output(['bash', '-c', cmd], stderr=subprocess.STDOUT)
        return output.decode()
    except subprocess.CalledProcessError as e:
        return f"Error: {e.output.decode()}"


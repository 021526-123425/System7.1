# ============================================
# Module B: Privacy & De-bloat (Debian)
# ============================================

remove_bloat(){
  echo -e "${GREEN}[*] Removing common desktop bloat...${RESET}"
  need_root_msg; apt_update_once
  <^>
  $SUDO apt autoremove -y
  mark_done_priv "bloat"
}

disable_telemetry(){
  echo -e "${GREEN}[*] Disabling telemetry & noisy services...${RESET}"
  need_root_msg
  # Ubuntu derivatives include whoopsie/apport; ignore errors on pure Debian
  $SUDO systemctl disable --now whoopsie 2>/dev/null || true
  $SUDO systemctl disable --now apport   2>/dev/null || true
  # Disable motd-news
  $SUDO systemctl mask motd-news.service 2>/dev/null || true
  if [[ -f /etc/default/motd-news ]]; then
    $SUDO sed -i 's/^ENABLED=.*/ENABLED=0/' /etc/default/motd-news || true
  fi
  mark_done_priv "telemetry"
}

harden_browser(){
  echo -e "${GREEN}[*] Applying Firefox privacy hardening (user.js)...${RESET}"
  PROFILE_DIR=$(find "$HOME/.mozilla/firefox" -maxdepth 1 -type d -name "*.default*" 2>/dev/null | head -n 1 || true)
  if [[ -n "${PROFILE_DIR:-}" ]]; then
    cat >> "$PROFILE_DIR/user.js" <<'EOF'
user_pref("privacy.resistFingerprinting", true);
user_pref("privacy.trackingprotection.enabled", true);
user_pref("network.cookie.cookieBehavior", 1);
user_pref("network.dns.disablePrefetch", true);
user_pref("network.prefetch-next", false);
user_pref("browser.safebrowsing.malware.enabled", true);
user_pref("browser.safebrowsing.phishing.enabled", true);
EOF
    echo "[OK] user.js updated: $PROFILE_DIR"
  else
    echo "[!] Firefox profile not found; skipping."
  fi
  mark_done_priv "browser"
}

secure_shell_history(){
  echo -e "${GREEN}[*] Securing shell history...${RESET}"
  {
    echo 'export HISTCONTROL=ignoreboth:erasedups'
    echo 'export HISTSIZE=1000'
    echo 'export HISTFILESIZE=2000'
  } >> "$HOME/.bashrc"
  mark_done_priv "shell"
}


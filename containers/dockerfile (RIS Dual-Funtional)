FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY environment.yml /app/
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install numpy scipy matplotlib numba cupy-cuda12x

COPY src/ /app/src/
COPY presets/ /app/presets/
COPY tools/demo_ris_dualfunc.py /app/tools/demo_ris_dualfunc.py

ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENTRYPOINT ["python3", "/app/tools/demo_ris_dualfunc.py"]
# tools/demo_acoular_biloc.py
import numpy as np
import soundfile as sf
import matplotlib.pyplot as plt
 
from acoular import MicGeom, TimeSamples, PointSource, Environment, \
    BeamformerBase, BeamformerCapon, BeamformerMUSIC, \
    RectGrid, FiltFiltOctave, BeamformerTime, IntegratorSector

# Load array preset (simple linear 16)
spacing = 0.035
mg = MicGeom()
mg.mpos = np.array([[i*spacing, 0.0, 0.0] for i in range(16)]).T

# Load sample (or generate)
try:
    sig, fs = sf.read("examples/sample.wav")
except Exception:
    fs = 48000
    t = np.linspace(0, 2, 2*fs, endpoint=False)
    sig = 0.3*np.sin(2*np.pi*440*t)

ts = TimeSamples(signal=sig, fs=fs)
env = Environment()

# Grid for localization
rg = RectGrid(x1=-1, x2=1, y1=-1, y2=1, nx=64, ny=64)

# Multi-mode localization for robustness
bf_base = BeamformerBase(freq=2000, grid=rg, mgeom=mg)
bf_capon = BeamformerCapon(freq=2000, grid=rg, mgeom=mg)
bf_music = BeamformerMUSIC(freq=2000, grid=rg, mgeom=mg)

maps = [bf_base.synthetic(ts), bf_capon.synthetic(ts), bf_music.synthetic(ts)]
conf_map = np.mean(np.stack(maps, axis=0), axis=0)

# Audible directional cue: beep panned to strongest bearing
idx = np.unravel_index(np.argmax(conf_map), conf_map.shape)
bearing = (idx[0] / rg.nx) * 180 - 90
print(f"Bearing acquired: {bearing:.1f}°")

plt.imshow(conf_map.T, origin='lower', extent=[rg.x1, rg.x2, rg.y1, rg.y2], cmap='inferno')
plt.title(f"Bi‑locational confidence map (bearing {bearing:.1f}°)")
plt.colorbar(label="confidence")
plt.show()

import signal
import threading
import time
import uinput


class VirtualControllerDaemon:
    """
    A production-safe daemon wrapper for Linux uinput virtual controllers.
    Handles:
      - device lifecycle
      - signal-safe shutdown
      - cleanup on crash
      - event loop management
    """

    def __init__(self, events, loop_rate=0.01):
        self.events = events
        self.loop_rate = loop_rate
        self.device = None
        self.running = threading.Event()
        self.running.set()

    # ---------------------------------------------------------
    # Public API
    # ---------------------------------------------------------

    def start(self):
        """Start the daemon and block until shutdown."""
        self._install_signal_handlers()
        self._create_device()
        self._run_loop()

    def stop(self):
        """External stop trigger."""
        self.running.clear()

    # ---------------------------------------------------------
    # Internal lifecycle
    # ---------------------------------------------------------

    def _install_signal_handlers(self):
        signal.signal(signal.SIGINT, self._handle_signal)
        signal.signal(signal.SIGTERM, self._handle_signal)

    def _handle_signal(self, *args):
        self.stop()

    def _create_device(self):
        self.device = uinput.Device(self.events)

    def _run_loop(self):
        try:
            while self.running.is_set():
                self.tick()
                time.sleep(self.loop_rate)
        finally:
            self._cleanup()

    def _cleanup(self):
        """Ensure the uinput device is destroyed cleanly."""
        if self.device:
            try:
                self.device.syn()
            except Exception:
                pass
            del self.device
            self.device = None

    # ---------------------------------------------------------
    # Overridable logic
    # ---------------------------------------------------------

    def tick(self):
        """
        Override this in subclasses.
        Called every loop iteration.
        """
        pass